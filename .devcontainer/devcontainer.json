// SCRIMMAGE Dev Container
//
// For full documentation including HPC/enroot usage, see:
//   development-docs/CONTAINERIZED_DEVELOPMENT.md
//
// QUICK START:
//   1. Open folder in VS Code → "Reopen in Container"
//   2. mkdir -p build && cd build
//   3. cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON .. && make -j$(nproc)
//   4. source ~/.scrimmage/setup.bash
//   5. scrimmage missions/straight-no-gui.xml
//
//   To persist keys across reboots:
//     macOS: ssh-add --apple-use-keychain ~/.ssh/id_rsa
//     Linux: Add `AddKeysToAgent yes` to ~/.ssh/config
//     Windows (PowerShell as Admin):
//       Get-Service ssh-agent | Set-Service -StartupType Automatic -PassThru | Start-Service
//       ssh-add $HOME\.ssh\id_rsa
//
{
  "name": "SCRIMMAGE Dev Container",
  "build": {
    "dockerfile": "../ci/dockerfiles/ubuntu-24.04-slim-dependency-only",
    "context": ".."
  },
  "workspaceFolder": "/root/scrimmage",
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/scrimmage,type=bind,consistency=cached",
  "runArgs": ["-v", "/tmp/.X11-unix:/tmp/.X11-unix"],
  "postStartCommand": "bash -lc 'git config --global --get-all safe.directory | grep -Fxq /root/scrimmage || git config --global --add safe.directory /root/scrimmage'",
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "initializeCommand": "ssh-add -l || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}/build"
        ],
        "cmake.configureArgs": [
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
        ],
        "C_Cpp.intelliSenseEngine": "disabled"
      }
    }
  }
}
