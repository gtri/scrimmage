{
  // High-signal install-tree tasks for an external SCRIMMAGE project.
  // Visible install tasks finish by opening a sourced runtime shell.
  // Helper tasks are hidden so the task picker stays small.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "_scrimmage-configure-release",
      "hide": true,
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSETUP_HOME_CONFIG=OFF",
        "-DCMAKE_INSTALL_PREFIX=/root/scrimmage/build/install",
        ".."
      ],
      "options": {
        "cwd": "/root/scrimmage/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_scrimmage-configure-debug",
      "hide": true,
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DSETUP_HOME_CONFIG=OFF",
        "-DCMAKE_INSTALL_PREFIX=/root/scrimmage/build/install",
        ".."
      ],
      "options": {
        "cwd": "/root/scrimmage/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_scrimmage-install",
      "hide": true,
      "type": "shell",
      "command": "make",
      "args": ["-j${input:jobs}", "install"],
      "options": {
        "cwd": "/root/scrimmage/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-configure-release",
      "hide": true,
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DSETUP_LOCAL_CONFIG_DIR=OFF",
        "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/install",
        "-Dscrimmage_DIR=/root/scrimmage/build/install/share/cmake/scrimmage",
        ".."
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-configure-debug",
      "hide": true,
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DSETUP_LOCAL_CONFIG_DIR=OFF",
        "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/install",
        "-Dscrimmage_DIR=/root/scrimmage/build/install/share/cmake/scrimmage",
        ".."
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-configure-debug-tests",
      "hide": true,
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DBUILD_TESTS=ON",
        "-DSETUP_LOCAL_CONFIG_DIR=OFF",
        "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/install",
        "-Dscrimmage_DIR=/root/scrimmage/build/install/share/cmake/scrimmage",
        ".."
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-install",
      "hide": true,
      "type": "shell",
      "command": "make",
      "args": ["-j${input:jobs}", "install"],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-build-tests",
      "hide": true,
      "type": "shell",
      "command": "make",
      "args": ["-j${input:jobs}"],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_prepare-tests-debug",
      "hide": true,
      "dependsOn": [
        "_scrimmage-configure-debug",
        "_scrimmage-install",
        "_project-configure-debug-tests",
        "_project-build-tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "_scrimmage-clean",
      "hide": true,
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "/root/scrimmage/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_project-clean",
      "hide": true,
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": []
    },
    {
      "label": "_install-release-all",
      "hide": true,
      "dependsOn": [
        "_scrimmage-configure-release",
        "_scrimmage-install",
        "_project-configure-release",
        "_project-install"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "_install-debug-all",
      "hide": true,
      "dependsOn": [
        "_scrimmage-configure-debug",
        "_scrimmage-install",
        "_project-configure-debug",
        "_project-install"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "_install-release-project-only",
      "hide": true,
      "dependsOn": [
        "_project-configure-release",
        "_project-install"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "install-release (scrimmage + project)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-ic",
        "set -e; source /root/scrimmage/build/install/etc/scrimmage/env/scrimmage-setenv; source \"${workspaceFolder}/build/install/etc/(>>>PROJECT_NAME<<<)/env/(>>>PROJECT_NAME<<<)-setenv\"; cd \"${workspaceFolder}\"; printf '\nSCRIMMAGE and (>>>PROJECT_NAME<<<) runtime environment loaded.\n'; exec bash -i"
      ],
      "dependsOn": ["_install-release-all"],
      "dependsOrder": "sequence",
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "install-debug (scrimmage + project)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-ic",
        "set -e; source /root/scrimmage/build/install/etc/scrimmage/env/scrimmage-setenv; source \"${workspaceFolder}/build/install/etc/(>>>PROJECT_NAME<<<)/env/(>>>PROJECT_NAME<<<)-setenv\"; cd \"${workspaceFolder}\"; printf '\nSCRIMMAGE and (>>>PROJECT_NAME<<<) runtime environment loaded.\n'; exec bash -i"
      ],
      "dependsOn": ["_install-debug-all"],
      "dependsOrder": "sequence",
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "install-release (project only)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-ic",
        "set -e; source /root/scrimmage/build/install/etc/scrimmage/env/scrimmage-setenv; source \"${workspaceFolder}/build/install/etc/(>>>PROJECT_NAME<<<)/env/(>>>PROJECT_NAME<<<)-setenv\"; cd \"${workspaceFolder}\"; printf '\nSCRIMMAGE and (>>>PROJECT_NAME<<<) runtime environment loaded.\n'; exec bash -i"
      ],
      "dependsOn": [
        "_install-release-project-only"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "open sourced shell",
      "type": "shell",
      "command": "bash",
      "args": [
        "-ic",
        "set -e; source /root/scrimmage/build/install/etc/scrimmage/env/scrimmage-setenv; source \"${workspaceFolder}/build/install/etc/(>>>PROJECT_NAME<<<)/env/(>>>PROJECT_NAME<<<)-setenv\"; cd \"${workspaceFolder}\"; printf '\nSCRIMMAGE and (>>>PROJECT_NAME<<<) runtime environment loaded.\n'; exec bash -i"
      ],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "ctest",
      "args": ["--output-on-failure"],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "dependsOn": ["_prepare-tests-debug"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test-verbose",
      "type": "shell",
      "command": "ctest",
      "args": ["--output-on-failure", "-V"],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "dependsOn": ["_prepare-tests-debug"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "dependsOn": ["_project-clean", "_scrimmage-clean"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "jobs",
      "type": "pickString",
      "description": "Number of parallel jobs",
      "options": ["4", "8", "12", "16"],
      "default": "8"
    }
  ]
}