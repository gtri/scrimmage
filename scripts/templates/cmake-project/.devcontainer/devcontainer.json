// External SCRIMMAGE project dev container
//
// Assumes sibling repositories on the host:
//   /code/scrimmage
//   /code/(>>>PROJECT_NAME<<<)
//
// SSH agent forwarding:
//   To persist keys across reboots:
//     macOS: ssh-add --apple-use-keychain ~/.ssh/id_rsa
//     Linux: Add `AddKeysToAgent yes` to ~/.ssh/config
//     Windows (PowerShell as Admin):
//       Get-Service ssh-agent | Set-Service -StartupType Automatic -PassThru | Start-Service
//       ssh-add $HOME\.ssh\id_rsa
//
// QUICK START:
//   1. Open this project in VS Code -> "Reopen in Container"
//   2. Build base SCRIMMAGE inside the container:
//        cd /root/scrimmage && mkdir -p build && cd build
//        cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_BUILD_TYPE=Debug \
//              -DSETUP_HOME_CONFIG=OFF -DCMAKE_INSTALL_PREFIX=$PWD/install ..
//        make -j$(nproc) install
//   3. Build this external project:
//        cd /root/(>>>PROJECT_NAME<<<) && mkdir -p build && cd build
//        cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_BUILD_TYPE=Debug \
//              -DSETUP_LOCAL_CONFIG_DIR=OFF \
//              -DCMAKE_INSTALL_PREFIX=$PWD/install \
//              -Dscrimmage_DIR=/root/scrimmage/build/install/share/cmake/scrimmage ..
//        make -j$(nproc) install
//   4. source /root/scrimmage/build/install/etc/scrimmage/env/scrimmage-setenv
//   5. source /root/(>>>PROJECT_NAME<<<)/build/install/etc/(>>>PROJECT_NAME<<<)/env/(>>>PROJECT_NAME<<<)-setenv
//   6. Press F5 or run scrimmage /root/(>>>PROJECT_NAME<<<)/missions/example.xml
//
{
  "name": "(>>>PROJECT_NAME<<<) Dev Container",
  "build": {
    "dockerfile": "../../scrimmage/ci/dockerfiles/ubuntu-24.04-slim-dependency-only",
    "context": "../../scrimmage"
  },
  "workspaceFolder": "/root/(>>>PROJECT_NAME<<<)",
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/(>>>PROJECT_NAME<<<),type=bind,consistency=cached",
  "mounts": [
    "source=${localWorkspaceFolder}/../scrimmage,target=/root/scrimmage,type=bind,consistency=cached",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "initializeCommand": "ssh-add -l || true",
  "postCreateCommand": "git config --global --add safe.directory /root/scrimmage && git config --global --add safe.directory /root/(>>>PROJECT_NAME<<<) && mkdir -p /root/scrimmage/build/install /root/(>>>PROJECT_NAME<<<)/build/install",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}/build"
        ],
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureArgs": [
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DSETUP_LOCAL_CONFIG_DIR=OFF",
          "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/build/install",
          "-Dscrimmage_DIR=/root/scrimmage/build/install/share/cmake/scrimmage"
        ],
        "C_Cpp.intelliSenseEngine": "disabled"
      }
    }
  },
  "postCreateCommand": "mkdir -p /root/scrimmage/build/install /root/(>>>PROJECT_NAME<<<)/build/install"
}
