<?xml version="1.0"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  name="Test Duplicate Plugin Names">

  <run start="0.0" end="3" dt="0.1"
    time_warp="0"
    enable_gui="false"
    network_gui="false"
    start_paused="false" />

  <end_condition>time</end_condition>
  <grid_spacing>10</grid_spacing>
  <grid_size>1000</grid_size>
  <terrain>mcmillan</terrain>
  <log_dir>~/.scrimmage/logs</log_dir>
  <create_latest_dir>false</create_latest_dir>
  <latitude_origin>35.721025</latitude_origin>
  <longitude_origin>-120.767925</longitude_origin>
  <altitude_origin>300</altitude_origin>
  <entity_interaction>SimpleCollision</entity_interaction>
  <seed>12345</seed>

  <!-- TEST: Two Straight autonomies with different params -->
  <!-- Should create keys: autonomy:Straight and autonomy:Straight:1 -->
  <entity>
    <name>duplicate_autonomy_test</name>
    <team_id>1</team_id>
    <color>77 77 255</color>
    <count>1</count>
    <health>1</health>

    <x>0</x>
    <y>0</y>
    <z>200</z>
    <heading>0</heading>

    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <visual_model>zephyr-blue</visual_model>

    <autonomy speed="10">Straight</autonomy>
    <autonomy speed="20">Straight</autonomy>
  </entity>

</runscript>
