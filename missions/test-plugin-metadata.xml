<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://gtri.gatech.edu"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  name="Test Plugin Metadata Refactor">

  <run start="0.0" end="5" dt="0.1"
    time_warp="0"
    enable_gui="false"
    network_gui="false"
    start_paused="false" />

  <stream_port>50051</stream_port>
  <stream_ip>localhost</stream_ip>

  <end_condition>time</end_condition>

  <grid_spacing>10</grid_spacing>
  <grid_size>1000</grid_size>

  <terrain>mcmillan</terrain>
  <background_color>191 191 191</background_color>
  <gui_update_period>10</gui_update_period>

  <plot_tracks>false</plot_tracks>
  <output_type>all</output_type>
  <show_plugins>false</show_plugins>

  <metrics>SimpleCollisionMetrics</metrics>

  <log_dir>~/.scrimmage/logs</log_dir>
  <create_latest_dir>false</create_latest_dir>

  <latitude_origin>35.721025</latitude_origin>
  <longitude_origin>-120.767925</longitude_origin>
  <altitude_origin>300</altitude_origin>

  <entity_interaction>SimpleCollision</entity_interaction>
  <network>LocalNetwork</network>

  <seed>12345</seed>

  <!-- ==================== TEST 1: Multiple Autonomies ==================== -->
  <!-- Tests: order field, multiple plugins of same type -->
  <entity>
    <name>multi_autonomy_entity</name>
    <team_id>1</team_id>
    <color>77 77 255</color>
    <count>1</count>
    <health>1</health>

    <x>0</x>
    <y>0</y>
    <z>200</z>
    <heading>0</heading>

    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <visual_model>zephyr-blue</visual_model>

    <!-- Two autonomies - order should be 0, 1 -->
    <autonomy speed="21" show_text_label="true">Straight</autonomy>
    <autonomy>MotorSchemas</autonomy>
  </entity>

  <!-- ==================== TEST 2: Plugin with Many Params ==================== -->
  <!-- Tests: params map with multiple attributes -->
  <entity>
    <name>params_test_entity</name>
    <team_id>1</team_id>
    <color>255 128 0</color>
    <count>1</count>
    <health>1</health>

    <x>100</x>
    <y>0</y>
    <z>200</z>
    <heading>90</heading>

    <controller gain="1.5" max_rate="10">SimpleAircraftControllerPID</controller>
    <motion_model max_speed="100" turn_rate="5">SimpleAircraft</motion_model>
    <visual_model>zephyr-blue</visual_model>

    <autonomy speed="30" altitude="250" behavior="aggressive">Straight</autonomy>
  </entity>

  <!-- ==================== TEST 3: Entity with Tag ==================== -->
  <!-- Tests: entity_tag field -->
  <entity tag="tagged_entity">
    <name>named_and_tagged</name>
    <team_id>2</team_id>
    <color>255 0 0</color>
    <count>1</count>
    <health>1</health>

    <x>200</x>
    <y>0</y>
    <z>200</z>
    <heading>180</heading>

    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <visual_model>zephyr-red</visual_model>

    <autonomy>Straight</autonomy>
  </entity>

  <!-- ==================== TEST 4: Multiple Sensors ==================== -->
  <!-- Tests: multiple sensors with different params -->
  <entity>
    <name>sensor_test_entity</name>
    <team_id>1</team_id>
    <color>0 255 0</color>
    <count>1</count>
    <health>1</health>

    <x>300</x>
    <y>0</y>
    <z>200</z>
    <heading>270</heading>

    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <visual_model>zephyr-blue</visual_model>

    <sensor range="500">RayTrace</sensor>
    <sensor fov="120">ContactBlobCamera</sensor>

    <autonomy>Straight</autonomy>
  </entity>

  <!-- ==================== TEST 5: Minimal Entity ==================== -->
  <!-- Tests: entity with no optional fields -->
  <entity>
    <team_id>1</team_id>
    <color>128 128 128</color>
    <count>1</count>
    <health>1</health>

    <x>400</x>
    <y>0</y>
    <z>200</z>
    <heading>0</heading>

    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <visual_model>zephyr-blue</visual_model>

    <autonomy>Straight</autonomy>
  </entity>

</runscript>
