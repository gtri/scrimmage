<?xml version="1.0"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  name="EntityCommonPluginImportTest">

  <run start="0.0" end="1" dt="0.1"
    time_warp="0"
    enable_gui="false"
    network_gui="false"
    start_paused="false" />

  <end_condition>time</end_condition>
  <grid_spacing>10</grid_spacing>
  <grid_size>1000</grid_size>
  <terrain>mcmillan</terrain>
  <log_dir>~/.scrimmage/logs</log_dir>
  <create_latest_dir>false</create_latest_dir>
  <latitude_origin>35.721025</latitude_origin>
  <longitude_origin>-120.767925</longitude_origin>
  <altitude_origin>300</altitude_origin>

  <entity_common name="shared_stack">
    <team_id>1</team_id>
    <color>77 77 255</color>
    <count>1</count>
    <health>1</health>
    <x>0</x>
    <y>0</y>
    <z>200</z>
    <heading>0</heading>
    <visual_model>zephyr-blue</visual_model>

    <autonomy speed="10">Straight</autonomy>
    <controller gain="1.5">SimpleAircraftControllerPID</controller>
    <motion_model max_speed="25">SimpleAircraft</motion_model>
    <sensor noise="0.1">NoisyState</sensor>
  </entity_common>

  <entity entity_common="shared_stack" tag="common_entity">
    <name>entity_common_stack</name>
    <autonomy speed="20">Straight</autonomy>
  </entity>
</runscript>