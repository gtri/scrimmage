FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies not covered by the setup scripts
RUN apt-get update && apt-get install -y \
    sudo git wget lsb-release cmake build-essential python3 python3-pip libssl-dev libffi-dev gnupg software-properties-common \
    protobuf-compiler libprotobuf-dev libprotoc-dev libgeographic-dev \
    libboost-all-dev librapidxml-dev libeigen3-dev \
    libvtk9-dev vtk9 \
    qtbase5-dev qttools5-dev qttools5-dev-tools libqt5opengl5-dev \
    vim \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory to /root on container start
WORKDIR /root

# Default command
CMD ["/bin/bash"]
