ENV CMAKE_MODULE_PATH="${CMAKE_MODULE_PATH}:/home/scrimmage_user/installs/opt/scrimmage/share/cmake"
ENV CMAKE_MODULE_PATH="${CMAKE_MODULE_PATH}:/home/scrimmage_user/installs/boost"
ENV CMAKE_PREFIX_PATH="${CMAKE_MODULE_PATH}"
ENV BOOST_ROOT="/home/scrimmage_user/installs/boost/"
