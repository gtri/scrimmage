FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SCRIMMAGE_DIR=/root/scrimmage

# Install dependencies not covered by the setup scripts
RUN apt-get update && apt-get install -y \
    sudo git wget lsb-release cmake build-essential python3 python3-pip libssl-dev libffi-dev gnupg software-properties-common \
    protobuf-compiler libprotobuf-dev libprotoc-dev libgeographiclib-dev \
    libboost-all-dev librapidxml-dev libeigen3-dev \
    libvtk9-dev vtk9 \
    libogre-next-dev ogre-next-tools \
    libx11-dev libxrandr-dev libxaw7-dev libgl1-mesa-dev libglu1-mesa-dev \
    qtbase5-dev qttools5-dev qttools5-dev-tools libqt5opengl5-dev \
    vim \
    clangd \
    lldb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set working directory to /root/scrimmage on container start
WORKDIR $SCRIMMAGE_DIR

# Clone the SCRIMMAGE repository into /root/scrimmage
# DEVNOTE: The only reason this is done is so that the jbsim installer scripts can be accessed.
#          It is expected the user will mount a local scrimmage repo into the container on startup.
RUN git clone --branch Ubuntu-24.04 https://github.com/gtri/scrimmage.git .

# Run setup scripts
RUN chmod +x ./setup/install-binaries.sh ./setup/install-jsbsim.sh
RUN ./setup/install-binaries.sh && ./setup/install-jsbsim.sh

# Default command
CMD ["/bin/bash"]

