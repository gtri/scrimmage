FROM almalinux:8 AS dependencies

SHELL ["/bin/bash", "-c"]

# Setup directories to work in
RUN mkdir -p /root/installs /root/rpms /root/3rd-party

# Install basic dependencies
RUN dnf -y update && dnf clean all && dnf -y install \
    wget \
    which \
    tar \
    xz \
    gcc \
    gcc-c++ \
    bzip2 \
    git \
    dnf-utils \
    bzip2-devel \
    procps \
    cmake \
    python3-devel \
    boost \
    libX11-devel \
    mesa-libGL \
    mesa-libGL-devel \
    libXt-devel \
    libxml2

#    eigen3-devel \
#    GeographicLib \
#    rapidxml-devel \
#    pybind11-devel \
#    protobuf-devel \
#    grpc-devel \
#    vtk-devel
