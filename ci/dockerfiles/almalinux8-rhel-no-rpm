ARG PKG_PREFIX=/opt/scrimmage
RUN mkdir -p ${PKG_PREFIX}

FROM dependencies AS builder

################################################################################
## Build SCRIMMAGE
################################################################################
WORKDIR /root/3rd-party
RUN git clone -b rhel-build-wsyre https://github.com/gtri/scrimmage.git
WORKDIR /root/3rd-party/scrimmage
RUN git checkout minimal && git pull && git status && mkdir build
WORKDIR ./build
