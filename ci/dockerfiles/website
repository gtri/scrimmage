###############################################################################
# Dockerfile to build SCRIMMAGE
# uses the ubuntu version that the current branch targets
###############################################################################
FROM ubuntu:24.04 AS dependencies

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-l", "-c"]

# Install initial dependencies and setup .bashrc
RUN apt-get update \
  && apt-get install -y \
    gnupg \
    gnupg2 \
    python3-pip \
    python3-venv \
    python3-sphinx \
    software-properties-common \
    clang \
    doxygen \
    graphviz \
    texlive-bibtex-extra \
    ccache \
    libvtk9-dev \
    wget \
  && python3 -m venv /root/scrimmage-venv \
  && source /root/scrimmage-venv/bin/activate \
  && pip install sphinx sphinx_git sphinx-rtd-theme

# Install jekyll
RUN gpg2 --keyserver hkp://keyserver.ubuntu.com --recv-keys 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB \
  && add-apt-repository -y ppa:rael-gc/rvm \
  && apt-get update \
  && apt-get install -y rvm \
  && groupadd rvm && usermod -a -G rvm root

RUN rvm autolibs packages \
  && rvm install ruby 3.3.9 \
  && gem install bundler && gem install jekyll

FROM dependencies AS builder

# Copy setup scripts into image
RUN mkdir -p /root/scrimmage/scrimmage/setup
COPY ./setup /root/scrimmage/scrimmage/setup

# Install anything that we need that we don't already have
RUN /root/scrimmage/scrimmage/setup/install-binaries.sh

COPY ./ /root/scrimmage/scrimmage/

# Build scrimmage core, plugins, and documentation
WORKDIR /root/scrimmage/scrimmage
RUN source /root/scrimmage-venv/bin/activate \
  && mkdir -p build \
  && cd build \
  && rm -rf * \
  && source ~/.bashrc \
  && cmake .. -DBUILD_TESTS=ON \
              -DBUILD_DOCS=ON \
              -DCMAKE_CXX_FLAGS="-Werror -Wno-error=deprecated-copy" \
  && make docs website-docs
